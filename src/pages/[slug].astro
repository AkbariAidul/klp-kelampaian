---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CHAPTERS, CHAPTER_SEO, type Chapter } from '../data/chapters';

export function getStaticPaths() {
  return CHAPTERS.map((chapter) => ({
    params: { slug: chapter.slug },
    props: { chapter },
  }));
}

interface Props {
  chapter: Chapter;
}

const { chapter } = Astro.props;
const seo = CHAPTER_SEO[chapter.slug as keyof typeof CHAPTER_SEO];

const fragments = import.meta.glob<string>('../content/chapters/*.html', {
  query: '?raw',
  import: 'default',
  eager: true,
});

const html = fragments[`../content/chapters/bab-${chapter.number}.html`];
if (!html) {
  throw new Error(`Fragmen bab ${chapter.number} tidak ditemukan`);
}
---

<BaseLayout
  title={`${chapter.cardTitle} — KLP Kelampaian`}
  description={seo.description}
  image={seo.image}
  imageWidth={seo.imageWidth}
  imageHeight={seo.imageHeight}
  imageAlt={seo.imageAlt}
>
  <article class="chapter-article" set:html={html} />
</BaseLayout>

<script>
  import { SITE } from '../data/site';

  const form = document.querySelector<HTMLFormElement>('#collab-form');

  if (form) {
    const button = form.querySelector<HTMLButtonElement>('#collab-submit');
    const buttonLabel = button?.querySelector<HTMLSpanElement>('span:last-child');
    const toast = document.getElementById('collab-toast');
    const waNumber = SITE.whatsappUrl.replace(/\D/g, '');
    let toastTimer = 0;

    const value = (id: string) =>
      (document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | null)?.value.trim() ?? '';

    const showToast = (html: string, autoHide: number) => {
      if (!toast) return;
      toast.innerHTML = `<div class="flex items-center gap-3 rounded-xl bg-inverse-surface px-4 py-3 text-xs font-semibold text-inverse-on-surface shadow-lg">${html}</div>`;
      toast.classList.remove('hidden');
      toast.classList.add('flex');
      window.clearTimeout(toastTimer);
      if (autoHide) {
        toastTimer = window.setTimeout(() => {
          toast.classList.add('hidden');
          toast.classList.remove('flex');
        }, autoHide);
      }
    };

    const spinner = '<span class="h-4 w-4 animate-spin rounded-full border-2 border-current border-t-transparent"></span>';

    form.addEventListener('submit', (event) => {
      event.preventDefault();

      const topic = document.getElementById('collab-topic') as HTMLSelectElement | null;
      const lines = [
        '*Formulir Kemitraan KLP Kelampaian*',
        '',
        `Nama: ${value('collab-name')}`,
        `Instansi: ${value('collab-org')}`,
        `Email: ${value('collab-email')}`,
        `WhatsApp: ${value('collab-wa')}`,
        `Peminatan: ${topic?.selectedOptions[0]?.textContent?.trim() ?? ''}`,
        '',
        'Pesan:',
        value('collab-message'),
      ];

      const text = encodeURIComponent(lines.join('\n'));
      const mobile = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);

      if (button) button.disabled = true;
      if (buttonLabel) buttonLabel.textContent = 'Membuka WhatsApp…';
      showToast(`${spinner}<span>Membuka WhatsApp…</span>`, 0);

      if (mobile) {
        window.location.href = `whatsapp://send?phone=${waNumber}&text=${text}`;
      } else {
        const url = `${SITE.whatsappUrl}?text=${text}`;
        const opened = window.open(url, '_blank');
        if (opened) opened.opener = null;
        else window.location.href = url;
      }

      window.setTimeout(() => {
        showToast(
          '<span class="material-symbols-outlined text-[18px] text-tertiary-fixed">check_circle</span><span>WhatsApp dibuka. Tekan Kirim di WhatsApp untuk mengirim pesan.</span>',
          8000,
        );
        if (button) button.disabled = false;
        if (buttonLabel) buttonLabel.textContent = 'Kirimkan Formulir Kemitraan';
      }, 1200);
    });
  }
</script>
