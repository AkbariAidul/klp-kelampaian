---
import { ACCENT_CLASSES, CHAPTERS, chapterHref } from '../data/chapters';
---

<section id="penjelajahan-bab" class="w-full bg-surface-container-low py-20">
  <div class="max-w-7xl mx-auto px-6 lg:px-12 flex flex-col gap-12">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-4 border-b border-outline-variant/30">
      <div class="flex flex-col gap-2 max-w-2xl">
        <div class="flex items-center gap-2 text-primary text-xs font-bold uppercase tracking-widest font-label">
          <span class="material-symbols-outlined text-[18px]" aria-hidden="true">menu_book</span>
          <span>Panduan Penilaian Portofolio Lengkap</span>
        </div>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-headline font-bold text-on-surface">
          Struktur Dokumen Portofolio Digital Impact
        </h2>
        <p class="text-sm text-on-surface-variant font-body">
          Navigasikan setiap bab kajian secara terperinci untuk memeriksa bukti empiris, rekam jejak dokumentasi,
          analisa dampak, hingga proyeksi skalabilitas regional.
        </p>
      </div>
      <span class="text-xs font-mono text-on-surface-variant">Klik kartu untuk membuka bab terkait</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        CHAPTERS.map((chapter) => {
          const accent = ACCENT_CLASSES[chapter.accent];
          return (
            <a
              class="group bg-surface-container-lowest p-6 rounded-2xl shadow-sm hover:shadow-lg transition-all duration-200 flex flex-col justify-between"
              href={chapterHref(chapter)}
            >
              <div class="flex flex-col gap-4">
                <div class="flex items-center justify-between">
                  <span class:list={['text-xs font-mono font-bold px-2.5 py-1 rounded', accent.badge]}>
                    BAB {chapter.number}
                  </span>
                  <span class="material-symbols-outlined text-outline transition-all group-hover:translate-x-1 group-hover:text-primary" aria-hidden="true">
                    arrow_forward
                  </span>
                </div>
                <div class="flex flex-col gap-1.5">
                  <h3 class="text-lg font-headline font-bold text-on-surface transition-colors group-hover:text-primary">
                    {chapter.cardTitle}
                  </h3>
                  <p class="text-xs text-on-surface-variant leading-relaxed">{chapter.summary}</p>
                </div>
              </div>
              <div class="mt-6 pt-4 border-t border-outline-variant/20 flex items-center justify-between text-[11px] text-on-surface-variant font-mono">
                <span>{chapter.meta}</span>
                <span class="text-primary font-semibold">Buka Pembahasan →</span>
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</section>
